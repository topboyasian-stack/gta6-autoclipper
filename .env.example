# Copy this file to .env for local use. Never commit your real .env or API key.
# Google AI Studio API key for episode planning. This is separate from Google AI Pro.
GEMINI_API_KEY=

# Text models currently used by Google AI Studio API
MYSTERY_PLANNER_MODEL=gemini-3.8-flash
MYSTERY_FALLBACK_MODEL=gemini-3.5-flash-lite

# Image API may be billed separately from Google AI Pro. Keep disabled unless explicitly approved.
MYSTERY_IMAGE_MODEL=gemini-3.1-flash-image
ALLOW_PAID_IMAGE_API=false
MAX_IMAGES_PER_API_RUN=10

# Use 10 scenes per Flow batch by default; absolute pipeline cap is 12.
MAX_SCENES_PER_FLOW_RUN=10

# Edge TTS narration and Faster-Whisper captions
MYSTERY_NARRATOR_VOICE=en-US-ChristopherNeural
MYSTERY_WHISPER_MODEL=base.en
MYSTERY_WHISPER_DEVICE=cpu

# Optional licensed music track
MYSTERY_MUSIC_TRACK=assets/music.mp3
